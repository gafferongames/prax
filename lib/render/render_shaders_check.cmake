# Reads the material types of a shader set of lib/render before its passes compile: fails with what is wrong and where,
# and writes what only the compiler knows of the set. pr_render_shaders (render_shaders.cmake) runs it in CMake's script
# mode. The script compiles one probe with slangc's front end alone: the set's sources, and a constant buffer for each
# type that holds the type's parameter record, its surface, its textures and its attributes. The compiler checks each
# structure against the interface that it implements (pr/render_surface.slang) as it compiles the sources, and its
# reflection of the probe and its syntax tree of the sources give the rest:
#
#     the sources declare no slots and no root data of their own
#     a member of a structure that is named as a method that the interfaces give a default is marked `override`, so
#     that the compiler checked its form, and it does not stand beside the default unused
#     a type's parameter record lays out in a buffer as it does in C (pr/gpu.slang), in a multiple of 16 bytes
#     each texture of a type is a RenderTexture marked RenderColor or RenderData, and each attribute is marked
#     RenderVertex with a semantic and a format that the field's type reads
#     the structure of each type's surface, which is its shading model
#
# It writes the set's data for C, which the set's source includes: each type's parameter record's size, its shading
# model, its textures and the layout of the attributes that it reads, with the layouts that the types share once. It
# writes the set's header, which names the ids of the set's types and tables and the index of each type's textures and
# attributes. And it writes the set's Slang: the code that fills each type's textures and attributes, the varyings of
# each layout, the dispatch on a material's type, and the sources of the passes that call the types, with their entry
# points.
#
#   cmake -DARGUMENTS=<path> -DHEADER=<path> -DDEPFILE=<path> -P render_shaders_check.cmake
#
# ARGUMENTS is a file that sets the rest: SLANGC, the INCLUDES that the probe includes from, the set's SOURCES, DEFINES
# and NAME, its TYPES and the STRUCTURES that implement them, in the order of their ids, its TABLE_IDS, the FUNCTION that
# returns the set, and the DIRECTORY of the probe, whose parent receives the set's files. HEADER is the set's data for C.
# The probe includes "render_shader_sources.slang", which includes the sources.

cmake_minimum_required(VERSION 3.28)

if (EXISTS ${CMAKE_CURRENT_LIST_DIR}/shader_reflect.cmake)
    include(${CMAKE_CURRENT_LIST_DIR}/shader_reflect.cmake)
else()
    include(${CMAKE_CURRENT_LIST_DIR}/../../cmake/shader_reflect.cmake)
endif()

include("${ARGUMENTS}")
if (NOT EXISTS "${SLANGC}")
    message(FATAL_ERROR "render_shaders_check: no slangc at ${SLANGC}")
endif()
# What a message names as the place of a mistake: the set's sources, or the library's for a set without any.
if (SOURCES)
    list(JOIN SOURCES ", " WHERE)
else()
    set(WHERE "lib/render")
endif()
set(WHERE "${WHERE}: shader set ${NAME}")
cmake_path(GET DIRECTORY PARENT_PATH SET_DIRECTORY)

# Fails with a message, which is printed as it is written: the compiler's own lines keep their columns.
function(fail text)
    message(NOTICE "${text}")
    message(FATAL_ERROR "The shader set ${NAME} is not built.")
endfunction()

# ----------------------------------------------------------------------------------------------------------------------
# The probe

# The buffer of type `index` is on line kFirstLine + index, which places a compiler's message.
set(kFirstLine 11)
set(probe "// Generated by render_shaders_check.cmake for the shader set ${NAME}. Do not edit.\n\n")
string(APPEND probe "#include \"render_shader_sources.slang\"\n\nstruct RenderProbe<M : IRenderMaterial> {\n")
string(APPEND probe "    M.Parameters parameters;\n    M.Surface surface;\n    M.Textures textures;\n")
string(APPEND probe "    M.Attributes attributes;\n};\n")
list(LENGTH TYPES count)
math(EXPR last "${count} - 1")
foreach (index RANGE ${last})
    list(GET STRUCTURES ${index} structure)
    string(APPEND probe "ConstantBuffer<RenderProbe<${structure}>> renderProbe${index};\n")
endforeach()
string(APPEND probe "\n[shader(\"compute\")]\n[numthreads(1, 1, 1)]\nvoid probe() {\n}\n")
file(CONFIGURE OUTPUT "${DIRECTORY}/probe.slang" CONTENT "${probe}" @ONLY)

# The probe compiles for the slots, which is the tier that declares every slot.
# The compiler writes its syntax tree of the probe, probe.slang-ast, into the directory that it runs in.
file(REMOVE "${DIRECTORY}/probe.slang-ast")
set(command "${SLANGC}" "${DIRECTORY}/probe.slang" -D PR_GPU_D3D12=1 -D PR_RENDER_SLOTS=1 -target hlsl -no-codegen
    -warnings-as-errors all -matrix-layout-row-major -reflection-json "${DIRECTORY}/probe.json"
    -depfile "${DIRECTORY}/probe.d" -dump-ast)
foreach (define IN LISTS DEFINES)
    list(APPEND command -D ${define}=1)
endforeach()
foreach (include IN LISTS INCLUDES)
    list(APPEND command -I "${include}")
endforeach()
execute_process(COMMAND ${command} WORKING_DIRECTORY "${DIRECTORY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
if (NOT result EQUAL 0)
    # A message that the compiler places in the sources is a mistake of theirs. One that it places only at a type's
    # buffer is about the structure that the set names for the type.
    string(REGEX MATCHALL " --> [^\n]*:[0-9]+:[0-9]+" places "${output}")
    set(named "")
    foreach (place IN LISTS places)
        if (NOT place MATCHES "probe\\.slang:([0-9]+):[0-9]+$")
            set(named "")
            break()
        elseif (named STREQUAL "")
            math(EXPR named "${CMAKE_MATCH_1} - ${kFirstLine}")
        endif()
    endforeach()
    if (named STREQUAL "" OR named LESS 0 OR named GREATER last)
        fail("${WHERE}: the sources do not compile.\n${output}")
    endif()
    list(GET TYPES ${named} type)
    list(GET STRUCTURES ${named} structure)
    fail("${WHERE}: material type ${type}: STRUCT names `${structure}`, and the sources define no structure of that \
name that implements IRenderMaterial (pr/render_surface.slang).\n${output}")
endif()
file(READ "${DIRECTORY}/probe.json" reflected)
set(INPUTS "${ARGUMENTS}")
read_depfile("${DIRECTORY}/probe.d")

# The methods that the interfaces of pr/render_surface.slang give a default. A structure replaces one with a method
# that it marks `override`, whose form the compiler then checks. A member of that name without the keyword is a member
# of the structure's own, which the compiler accepts beside the default: a shading model whose emission has another
# form than the interface's would emit nothing, and say nothing. The compiler's reflection does not list a structure's
# methods, so the check reads them in the syntax tree: each declaration there states its modifiers, the declaration
# that holds it, and its name with the place of its source.
set(DEFAULTED emittedRadiance)
file(READ "${DIRECTORY}/probe.slang-ast" tree)
set(overrides 0)
foreach (member IN LISTS DEFAULTED)
    set(declaration "(FuncDecl|VarDecl|PropertyDecl):[0-9]+ {\n    loc : [^\n]*\n    modifiers :  { \n([^}]*)}\n    \
parentDecl : (StructDecl|ExtensionDecl):[0-9]+\n    nameAndLoc : NameLoc{\"${member}\", SourceLoc\\([0-9]+\\) ([^\n]*) }")
    string(REGEX MATCHALL "${declaration}" found "${tree}")
    foreach (item IN LISTS found)
        string(REGEX MATCH "${declaration}" matched "${item}")
        set(modifiers "${CMAKE_MATCH_2}")
        set(place "${CMAKE_MATCH_4}")
        if (modifiers MATCHES "OverrideModifier")
            math(EXPR overrides "${overrides} + 1")
        else()
            fail("${place}: shader set ${NAME}: a structure declares `${member}` without `override`. A shading \
model that replaces the ${member} of IRenderSurface or IRenderSimpleSurface (pr/render_surface.slang) marks its method \
`override`, and the compiler then checks the method's form. Without the keyword the method is another one, the \
interface's default is called in its place, and the build would not say so. A member that is not the interface's \
takes another name.")
        endif()
    endforeach()
endforeach()
# The library's own model replaces every such method, so a tree in which the check finds none has another form than
# the check reads.
if (overrides EQUAL 0)
    fail("render_shaders_check: the syntax tree that slangc dumps for the shader set ${NAME} does not show the \
library's own methods. This script reads the form that slangc of cmake/slang.cmake's version writes.")
endif()

# The probe's parameters: each type's buffer, by its index, and the library's slots, which are named renderSlot..., and
# its root data, push and frame. Any other is a slot that the sources declare. The slots of a material's textures are
# counted: a type that declares no more textures than they has each in the slot of its index (pr/render_surface.slang).
string(JSON parameter_count LENGTH "${reflected}" parameters)
math(EXPR parameter_last "${parameter_count} - 1")
set(material_slots 0)
foreach (index RANGE ${parameter_last})
    string(JSON name GET "${reflected}" parameters ${index} name)
    if (name MATCHES "^renderSlotMaterialTexture[0-9]+$")
        math(EXPR material_slots "${material_slots} + 1")
    endif()
    if (name MATCHES "^renderProbe([0-9]+)$")
        string(JSON buffer_${CMAKE_MATCH_1} GET "${reflected}" parameters ${index} type elementType)
    elseif (NOT name MATCHES "^(renderSlot|prGpu)" AND NOT name MATCHES "^(push|frame)$")
        fail("${WHERE}: the sources declare `${name}`, which takes a slot. A material and a shading \
model declare no slots and no root data: a material samples the textures that its material names \
(pr/render_material.slang), and reads its numbers from its parameter record.")
    endif()
endforeach()

# ----------------------------------------------------------------------------------------------------------------------
# The formats of attributes

# By the name of a format of lib/gpu (PrGpuVertexFormat) in lowercase: the format's name in C, its components for
# lib/mesh (PrMeshFormat), its size in bytes, the type that a shader reads it as, and the expression that reads it from
# its words w0 to w3 (pr/render_scene.slang).
set(kFormats float float2 float3 float4 half2 half4 uint uint2 uint3 uint4 sint sint2 sint3 sint4 unorm8x4 snorm8x4
    uint8x4 unorm16x2 unorm16x4 snorm16x2 snorm16x4)
set(format_float "Float|Float32|1|false|4|float|asfloat(w0)")
set(format_float2 "Float2|Float32|2|false|8|float2|asfloat(uint2(w0, w1))")
set(format_float3 "Float3|Float32|3|false|12|float3|asfloat(uint3(w0, w1, w2))")
set(format_float4 "Float4|Float32|4|false|16|float4|asfloat(uint4(w0, w1, w2, w3))")
set(format_half2 "Half2|Float16|2|false|4|float2|renderHalf2(w0)")
set(format_half4 "Half4|Float16|4|false|8|float4|renderHalf4(w0, w1)")
set(format_uint "Uint|Uint32|1|false|4|uint|w0")
set(format_uint2 "Uint2|Uint32|2|false|8|uint2|uint2(w0, w1)")
set(format_uint3 "Uint3|Uint32|3|false|12|uint3|uint3(w0, w1, w2)")
set(format_uint4 "Uint4|Uint32|4|false|16|uint4|uint4(w0, w1, w2, w3)")
set(format_sint "Sint|Int32|1|false|4|int|int(w0)")
set(format_sint2 "Sint2|Int32|2|false|8|int2|int2(uint2(w0, w1))")
set(format_sint3 "Sint3|Int32|3|false|12|int3|int3(uint3(w0, w1, w2))")
set(format_sint4 "Sint4|Int32|4|false|16|int4|int4(uint4(w0, w1, w2, w3))")
set(format_unorm8x4 "Unorm8x4|Uint8|4|true|4|float4|renderUnorm8x4(w0)")
set(format_snorm8x4 "Snorm8x4|Int8|4|true|4|float4|renderSnorm8x4(w0)")
set(format_uint8x4 "Uint8x4|Uint8|4|false|4|uint4|renderUint8x4(w0)")
set(format_unorm16x2 "Unorm16x2|Uint16|2|true|4|float2|renderUnorm16x2(w0)")
set(format_unorm16x4 "Unorm16x4|Uint16|4|true|8|float4|renderUnorm16x4(w0, w1)")
set(format_snorm16x2 "Snorm16x2|Int16|2|true|4|float2|renderSnorm16x2(w0)")
set(format_snorm16x4 "Snorm16x4|Int16|4|true|8|float4|renderSnorm16x4(w0, w1)")

# Sets `out` to the Slang type of a reflected field: a scalar or a vector of floats, unsigned or signed integers, or a
# structure's name.
function(slang_type out type)
    string(JSON kind GET "${type}" kind)
    set(name "")
    if (kind STREQUAL "struct")
        string(JSON name GET "${type}" name)
    elseif (kind STREQUAL "scalar" OR kind STREQUAL "vector")
        set(scalar_type "${type}")
        set(count "")
        if (kind STREQUAL "vector")
            string(JSON scalar_type GET "${type}" elementType)
            string(JSON count GET "${type}" elementCount)
        endif()
        string(JSON scalar GET "${scalar_type}" scalarType)
        if (scalar STREQUAL "float32")
            set(name "float${count}")
        elseif (scalar STREQUAL "uint32")
            set(name "uint${count}")
        elseif (scalar STREQUAL "int32")
            set(name "int${count}")
        else()
            set(name "${scalar}${count}")
        endif()
    else()
        set(name "${kind}")
    endif()
    set(${out} "${name}" PARENT_SCOPE)
endfunction()

# Sets `out` to a reflected number as a C float.
function(c_float out number)
    if (NOT number MATCHES "[.eE]")
        string(APPEND number ".0")
    endif()
    set(${out} "${number}f" PARENT_SCOPE)
endfunction()

# Sets `out` to the name of a field with its first letter in capitals, for the name of a constant.
function(capitalized out name)
    string(SUBSTRING "${name}" 0 1 first)
    string(SUBSTRING "${name}" 1 -1 rest)
    string(TOUPPER "${first}" first)
    set(${out} "${first}${rest}" PARENT_SCOPE)
endfunction()

# ----------------------------------------------------------------------------------------------------------------------
# The types

# Each type's parameter record, surface, textures and attributes. The types of one surface are a shading model's, in
# `models`, and the types of one layout of attributes share it, in `layouts`.
set(models "")
set(layout_keys "")
set(layout_count 0)
set(c_textures "")
set(c_parameters "")
set(c_optionals "")
set(c_variants "")
set(variant_count 0)
set(c_types "")
set(c_layouts "")
set(constants "")
set(slang_types "")
foreach (index RANGE ${last})
    list(GET TYPES ${index} type)
    list(GET STRUCTURES ${index} structure)
    set(type_where "${WHERE}: material type ${type}")
    string(JSON record GET "${buffer_${index}}" fields 0 type)
    string(JSON record_name ERROR_VARIABLE unnamed GET "${record}" name)
    if (unnamed)
        set(record_name "${structure}.Parameters")
    endif()
    set(PROBLEMS "")
    buffer_layout_problems("${record}" "${record_name}")
    math(EXPR remainder "${PACKED} % 16")
    if (NOT remainder EQUAL 0)
        list(APPEND PROBLEMS "${record_name} is ${PACKED} bytes. A record's size is a multiple of 16 bytes")
    endif()
    if (PROBLEMS)
        list(TRANSFORM PROBLEMS PREPEND "${type_where}: its parameter record ")
        list(JOIN PROBLEMS ".\n" text)
        fail("${text}.")
    endif()
    set(parameter_bytes ${PACKED})
    string(JSON surface GET "${buffer_${index}}" fields 1 type name)

    # The parameters: each field of the record but padding, marked with its value where a material does not set it, at
    # its offset as a shader loads the record, every field after the one before.
    string(JSON parameter_count ERROR_VARIABLE none LENGTH "${record}" fields)
    if (none)
        set(parameter_count 0)
    endif()
    set(type_parameters "")
    set(parameter_number 0)
    set(offset 0)
    if (parameter_count GREATER 0)
        math(EXPR parameter_last "${parameter_count} - 1")
        foreach (f RANGE ${parameter_last})
            string(JSON field GET "${record}" fields ${f})
            string(JSON field_name GET "${field}" name)
            string(JSON field_type GET "${field}" type)
            set(PROBLEMS "")
            buffer_layout_problems("${field_type}" "${field_name}")
            set(size ${PACKED})
            if (field_name MATCHES "^_pad")
                math(EXPR offset "${offset} + ${size}")
                continue()
            endif()
            string(JSON mark ERROR_VARIABLE unmarked GET "${field}" userAttribs 0 name)
            string(JSON kind GET "${field_type}" kind)
            set(elements 1)
            if (kind STREQUAL "array")
                string(JSON elements GET "${field_type}" elementCount)
                string(JSON field_type GET "${field_type}" elementType)
                string(JSON kind GET "${field_type}" kind)
            endif()
            if (unmarked OR NOT mark STREQUAL "RenderParameter" OR NOT kind MATCHES "^(scalar|vector)$")
                fail("${type_where}: its parameter `${field_name}` is a scalar, a vector or an array of either marked \
[RenderParameter(x, y, z, w)], which gives its value where a material does not set it, or padding named _pad \
(pr/render_surface.slang).")
            endif()
            set(scalar_type "${field_type}")
            set(components 1)
            if (kind STREQUAL "vector")
                string(JSON scalar_type GET "${field_type}" elementType)
                string(JSON components GET "${field_type}" elementCount)
            endif()
            string(JSON scalar GET "${scalar_type}" scalarType)
            set(parameter_kind Float)
            if (scalar STREQUAL "int32")
                set(parameter_kind Int)
            elseif (scalar STREQUAL "uint32")
                set(parameter_kind Uint)
            endif()
            set(values "")
            foreach (k RANGE 3)
                string(JSON number GET "${field}" userAttribs 0 arguments ${k})
                c_float(number "${number}")
                list(APPEND values "${number}")
            endforeach()
            list(JOIN values ", " values)
            string(APPEND type_parameters "    {\"${field_name}\", ${offset}, ${components}, ${elements}, ")
            string(APPEND type_parameters "PrRenderParameterKind_${parameter_kind}, {${values}}},\n")
            capitalized(capital "${field_name}")
            string(APPEND constants "    k${NAME}${type}Parameter${capital} = ${parameter_number},\n")
            math(EXPR parameter_number "${parameter_number} + 1")
            math(EXPR offset "${offset} + ${size}")
        endforeach()
    endif()
    set(parameters_name "nullptr")
    if (parameter_number GREATER 0)
        set(parameters_name "k${type}Parameters")
        string(APPEND c_parameters "const PrRenderMaterialParameter k${type}Parameters[] = {\n${type_parameters}};\n\n")
    endif()
    string(APPEND constants "    k${NAME}${type}ParameterCount = ${parameter_number},\n")

    # The textures: each a RenderTexture, marked with its kind and its stand-in.
    string(JSON textures GET "${buffer_${index}}" fields 2 type)
    string(JSON texture_count ERROR_VARIABLE none LENGTH "${textures}" fields)
    if (none)
        set(texture_count 0)
    endif()
    set(slots_are_indices "true")
    if (texture_count GREATER material_slots)
        set(slots_are_indices "false")
    endif()
    set(fill "    ${structure}.Textures textures;\n")
    set(type_textures "")
    if (texture_count GREATER 0)
        math(EXPR texture_last "${texture_count} - 1")
        foreach (t RANGE ${texture_last})
            string(JSON field GET "${textures}" fields ${t})
            string(JSON field_name GET "${field}" name)
            string(JSON field_type GET "${field}" type)
            slang_type(shader_type "${field_type}")
            # The marks: its kind with its stand-in, and the channels that the type reads, which are all four
            # without one.
            string(JSON mark_count ERROR_VARIABLE unmarked LENGTH "${field}" userAttribs)
            if (unmarked)
                set(mark_count 0)
            endif()
            set(kind "")
            set(kind_mark -1)
            set(channels "PrRenderChannelFlag_Rgba")
            if (mark_count GREATER 0)
                math(EXPR mark_last "${mark_count} - 1")
                foreach (m RANGE ${mark_last})
                    string(JSON mark GET "${field}" userAttribs ${m} name)
                    if (mark MATCHES "^Render(Color|Data)$")
                        set(kind "${CMAKE_MATCH_1}")
                        set(kind_mark ${m})
                    elseif (mark STREQUAL "RenderReads")
                        string(JSON reads GET "${field}" userAttribs ${m} arguments 0)
                        if (reads STREQUAL "chosen")
                            set(channels "PrRenderChannelFlag_Chosen")
                        elseif (reads MATCHES "^r?g?b?a?$" AND NOT reads STREQUAL "")
                            set(channels "")
                            foreach (letter r g b a)
                                string(FIND "${reads}" "${letter}" at)
                                if (NOT at EQUAL -1)
                                    string(TOUPPER "${letter}" capital)
                                    list(APPEND channels "PrRenderChannelFlag_${capital}")
                                endif()
                            endforeach()
                            list(JOIN channels " | " channels)
                        else()
                            fail("${type_where}: its texture `${field_name}` is marked [RenderReads(\"${reads}\")], \
which names some of r, g, b and a in that order, or chosen (pr/render_surface.slang).")
                        endif()
                    endif()
                endforeach()
            endif()
            if (NOT shader_type STREQUAL "RenderTexture" OR kind STREQUAL "")
                fail("${type_where}: its texture `${field_name}` is a RenderTexture marked [RenderColor(r, g, b, a)] or \
[RenderData(r, g, b, a)], which give its kind and its stand-in (pr/render_surface.slang).")
            endif()
            set(values "")
            foreach (k RANGE 3)
                string(JSON number GET "${field}" userAttribs ${kind_mark} arguments ${k})
                c_float(number "${number}")
                list(APPEND values "${number}")
            endforeach()
            list(JOIN values ", " values)
            string(APPEND type_textures "    {\"${field_name}\", PrRenderTextureKind_${kind}, ${channels}, {${values}}},\n")
            string(APPEND fill "    textures.${field_name} = renderMaterialTexture(material, ${t}, ")
            string(APPEND fill "${slots_are_indices});\n")
            capitalized(capital "${field_name}")
            string(APPEND constants "    k${NAME}${type}Texture${capital} = ${t},\n")
        endforeach()
    endif()
    set(textures_name "nullptr")
    if (texture_count GREATER 0)
        set(textures_name "k${type}Textures")
        string(APPEND c_textures "const PrRenderMaterialTexture k${type}Textures[] = {\n${type_textures}};\n\n")
    endif()
    string(APPEND constants "    k${NAME}${type}TextureCount = ${texture_count},\n")
    string(APPEND slang_types "\n// The textures of a material of the type ${type}.\n")
    string(APPEND slang_types "${structure}.Textures renderTextures${index}(PrRenderMaterialRecord material) {\n")
    string(APPEND slang_types "${fill}    return textures;\n}\n")

    # The attributes: each marked with its semantic, its format and its value where a vertex lacks it, and optional or
    # not. Each set of the optional attributes is a variant of the type, whose layout holds the attributes that are
    # not optional and those of the set, and whose shaders give the others their values. The key of a variant's
    # attributes, which variants of equal attributes share, names the layout.
    string(JSON attributes GET "${buffer_${index}}" fields 3 type)
    string(JSON attribute_count ERROR_VARIABLE none LENGTH "${attributes}" fields)
    if (none)
        set(attribute_count 0)
    endif()
    set(fields_${index} "")
    set(optionals "")
    set(optional_count 0)
    if (attribute_count GREATER 0)
        math(EXPR attribute_last "${attribute_count} - 1")
        foreach (a RANGE ${attribute_last})
            string(JSON field GET "${attributes}" fields ${a})
            string(JSON field_name GET "${field}" name)
            string(JSON field_type GET "${field}" type)
            slang_type(shader_type "${field_type}")
            set(attribute_where "${type_where}: its attribute `${field_name}`")
            string(JSON mark_count ERROR_VARIABLE unmarked LENGTH "${field}" userAttribs)
            if (unmarked)
                set(mark_count 0)
            endif()
            set(vertex_mark -1)
            set(optional 0)
            if (mark_count GREATER 0)
                math(EXPR mark_last "${mark_count} - 1")
                foreach (m RANGE ${mark_last})
                    string(JSON mark GET "${field}" userAttribs ${m} name)
                    if (mark STREQUAL "RenderVertex")
                        set(vertex_mark ${m})
                    elseif (mark STREQUAL "RenderOptional")
                        set(optional 1)
                    endif()
                endforeach()
            endif()
            if (vertex_mark EQUAL -1)
                fail("${attribute_where} is marked [RenderVertex(semantic, format, x, y, z, w)], which give its \
semantic, the format that a vertex stores it in, and its value where a vertex lacks it (pr/render_surface.slang).")
            endif()
            string(JSON semantic GET "${field}" userAttribs ${vertex_mark} arguments 0)
            string(JSON format GET "${field}" userAttribs ${vertex_mark} arguments 1)
            if (NOT format IN_LIST kFormats)
                list(JOIN kFormats ", " known)
                fail("${attribute_where} has the format `${format}`, which is none of lib/gpu's vertex formats: \
${known}.")
            endif()
            string(REPLACE "|" ";" description "${format_${format}}")
            list(GET description 5 format_type)
            if (semantic STREQUAL "uv")
                if (NOT shader_type STREQUAL "RenderTexCoord" OR NOT format_type STREQUAL "float2")
                    fail("${attribute_where} is of the semantic uv, which is a RenderTexCoord in a format of two \
numbers that a shader reads as floats.")
                endif()
            elseif (semantic STREQUAL "color")
                if (NOT shader_type STREQUAL "float4" OR NOT format_type STREQUAL "float4")
                    fail("${attribute_where} is of the semantic color, which is a float4 in a format of four numbers \
that a shader reads as floats.")
                endif()
            elseif (semantic STREQUAL "custom")
                if (NOT shader_type STREQUAL format_type)
                    fail("${attribute_where} is a ${shader_type}, and its format ${format} is read as a \
${format_type}.")
                endif()
            else()
                fail("${attribute_where} has the semantic `${semantic}`, which is none of uv, color and custom.")
            endif()
            set(values "")
            foreach (k RANGE 2 5)
                string(JSON number GET "${field}" userAttribs ${vertex_mark} arguments ${k})
                list(APPEND values "${number}")
            endforeach()
            list(JOIN values "," values)
            set(bit 0)
            if (optional)
                math(EXPR bit "1 << ${optional_count}")
                math(EXPR optional_count "${optional_count} + 1")
                list(APPEND optionals "\"${field_name}\"")
            endif()
            list(APPEND fields_${index} "${field_name}|${semantic}|${format}|${values}|${bit}")
        endforeach()
    endif()
    if (optional_count GREATER 4)
        fail("${type_where} declares ${optional_count} optional attributes, and a type declares at most 4: each set of \
them is a variant of the type, with shaders of its own.")
    endif()
    set(attribute_number 0)
    foreach (attribute IN LISTS fields_${index})
        string(REPLACE "|" ";" parts "${attribute}")
        list(GET parts 0 field_name)
        capitalized(capital "${field_name}")
        string(APPEND constants "    k${NAME}${type}Attribute${capital} = ${attribute_number},\n")
        math(EXPR attribute_number "${attribute_number} + 1")
    endforeach()

    if (NOT surface IN_LIST models)
        list(APPEND models ${surface})
        set(model_${surface}_variants "")
    endif()
    set(type_surface_${index} "${surface}")
    set(type_first_variant_${index} ${variant_count})
    math(EXPR variants "1 << ${optional_count}")
    math(EXPR variant_last "${variants} - 1")
    foreach (mask RANGE ${variant_last})
        set(key "")
        set(present "")
        foreach (attribute IN LISTS fields_${index})
            string(REPLACE "|" ";" parts "${attribute}")
            list(GET parts 4 bit)
            math(EXPR selected "${mask} & ${bit}")
            if (bit EQUAL 0 OR NOT selected EQUAL 0)
                list(GET parts 0 field_name)
                list(GET parts 1 semantic)
                list(GET parts 2 format)
                list(GET parts 3 values)
                string(APPEND key "${field_name}/${semantic}/${format}/${values}&")
                list(APPEND present "${field_name}|${semantic}|${format}|${values}")
            endif()
        endforeach()
        list(FIND layout_keys "${key}" layout)
        if (layout EQUAL -1)
            set(layout ${layout_count})
            list(APPEND layout_keys "${key}")
            set(layout_fields_${layout} "${present}")
            set(layout_variants_${layout} "")
            math(EXPR layout_count "${layout_count} + 1")
        endif()
        set(fragment "forwardPixel${type}")
        if (mask GREATER 0)
            set(fragment "forwardPixel${type}${mask}")
        endif()
        list(APPEND layout_variants_${layout} ${variant_count})
        list(APPEND model_${surface}_variants ${variant_count})
        set(variant_type_${variant_count} ${index})
        set(variant_layout_${variant_count} ${layout})
        set(variant_mask_${variant_count} ${mask})
        set(variant_fragment_${variant_count} "${fragment}")
        string(APPEND c_variants "    {${index}, ${mask}, \"${fragment}\", ${layout}},\n")
        math(EXPR variant_count "${variant_count} + 1")
    endforeach()

    set(optionals_name "nullptr")
    if (optional_count GREATER 0)
        set(optionals_name "k${type}Optionals")
        list(JOIN optionals ", " optionals)
        string(APPEND c_optionals "const PrStringView k${type}Optionals[] = {${optionals}};\n\n")
    endif()
    string(APPEND c_types "    {\n        \"${type}\",\n        \"${surface}\",\n        ${parameter_bytes},\n")
    string(APPEND c_types "        ${parameters_name},\n        ${parameter_number},\n")
    string(APPEND c_types "        ${textures_name},\n        ${texture_count},\n")
    string(APPEND c_types "        ${optionals_name},\n        ${optional_count},\n")
    string(APPEND c_types "        ${type_first_variant_${index}},\n        ${variants},\n    },\n")
endforeach()

# ----------------------------------------------------------------------------------------------------------------------
# The layouts

# Each layout's attributes for C, and in Slang: the attributes that its vertex shader fetches, the varyings that carry
# them, the values that a shader that pulls a vertex reads, and the code that fills each type's attributes from them.
set(slang_layouts "")
math(EXPR layout_last "${layout_count} - 1")
foreach (layout RANGE ${layout_last})
    set(offset 0)
    set(c_attributes "")
    set(vertex_fields "")
    set(varying_fields "")
    set(value_fields "")
    set(point_fields "")
    set(point_fill "")
    set(copy "")
    set(pull "")
    set(location 3)
    set(varying 8)
    set(uv_index 0)
    set(color_index 0)
    set(custom_index 0)
    foreach (attribute IN LISTS layout_fields_${layout})
        string(REPLACE "|" ";" parts "${attribute}")
        list(GET parts 0 field_name)
        list(GET parts 1 semantic)
        list(GET parts 2 format)
        list(GET parts 3 values)
        string(REPLACE "|" ";" description "${format_${format}}")
        list(GET description 0 gpu_format)
        list(GET description 1 component)
        list(GET description 2 components)
        list(GET description 3 normalized)
        list(GET description 4 size)
        list(GET description 5 format_type)
        list(GET description 6 decode)
        string(REPLACE "," ";" values "${values}")
        set(fallback "")
        foreach (number IN LISTS values)
            c_float(number "${number}")
            list(APPEND fallback "${number}")
        endforeach()
        list(JOIN fallback ", " fallback)
        if (semantic STREQUAL "uv")
            set(semantic_name Uv)
            set(semantic_index ${uv_index})
            math(EXPR uv_index "${uv_index} + 1")
        elseif (semantic STREQUAL "color")
            set(semantic_name Color)
            set(semantic_index ${color_index})
            math(EXPR color_index "${color_index} + 1")
        else()
            set(semantic_name Custom)
            set(semantic_index ${custom_index})
            math(EXPR custom_index "${custom_index} + 1")
        endif()
        string(APPEND c_attributes "    {\"${field_name}\", PrRenderSemantic_${semantic_name}, ${semantic_index}, ")
        string(APPEND c_attributes "{PrMeshComponent_${component}, ${components}, ${normalized}}, ${offset}, ")
        string(APPEND c_attributes "{${fallback}}},\n")
        # An integer is the same at each corner of a triangle, the first's.
        set(interpolation "")
        if (format_type MATCHES "^u?int")
            set(interpolation "nointerpolation ")
        endif()
        string(APPEND vertex_fields "    PR_GPU_ATTRIBUTE(${format_type}, ${field_name}, ${location});\n")
        string(APPEND varying_fields "    ${interpolation}${format_type} ${field_name} : TEXCOORD${varying};\n")
        string(APPEND value_fields "    ${format_type} ${field_name};\n")
        if (semantic STREQUAL "uv")
            string(APPEND point_fields "    RenderTexCoord ${field_name};\n")
            string(APPEND point_fill "    point.${field_name} = renderVaryingTexCoord(input.${field_name});\n")
        else()
            string(APPEND point_fields "    ${format_type} ${field_name};\n")
            string(APPEND point_fill "    point.${field_name} = input.${field_name};\n")
        endif()
        string(APPEND copy "    out.${field_name} = attributes.${field_name};\n")
        math(EXPR words "${size} / 4")
        math(EXPR word_last "${words} - 1")
        string(APPEND pull "    {\n")
        foreach (w RANGE ${word_last})
            math(EXPR at "${offset} + ${w} * 4")
            string(APPEND pull "        uint w${w} = renderAttributeWord(draw, index, kRenderLayout${layout}Stride, ")
            string(APPEND pull "${at});\n")
        endforeach()
        string(APPEND pull "        values.${field_name} = ${decode};\n    }\n")
        math(EXPR offset "${offset} + ${size}")
        math(EXPR location "${location} + 1")
        math(EXPR varying "${varying} + 1")
        set(layout_${layout}_${field_name} "${semantic}|${format_type}")
    endforeach()
    list(LENGTH layout_fields_${layout} attribute_count)
    set(layout_${layout}_count ${attribute_count})
    set(layout_${layout}_varyings "${varying_fields}")
    set(attributes_name "nullptr")
    if (attribute_count GREATER 0)
        set(attributes_name "kLayout${layout}Attributes")
        string(APPEND c_layouts "const PrRenderVertexAttribute kLayout${layout}Attributes[] = {\n${c_attributes}};\n\n")
    endif()
    set(c_layout_${layout} "    {\n        ${attributes_name},\n        ${attribute_count},\n        ${offset},\n")
    string(APPEND c_layout_${layout} "        \"forwardVertex${layout}\",\n        \"depthMaskVertex${layout}\",\n")
    string(APPEND c_layout_${layout} "        \"depthMaskPixel${layout}\",\n    },\n")

    string(APPEND slang_layouts "\n// --------------------------------------------------------------------------------")
    string(APPEND slang_layouts "-------------------------------------\n")
    string(APPEND slang_layouts "// Layout ${layout}\n\n")
    string(APPEND slang_layouts "static const uint kRenderLayout${layout}Stride = ${offset};\n\n")
    # One structure holds the geometry and the attributes, since a target numbers the locations of a second parameter
    # after those of the first.
    string(APPEND slang_layouts "// A vertex of the layout, as a vertex shader fetches it: the geometry, and the ")
    string(APPEND slang_layouts "layout's attributes after it.\n")
    string(APPEND slang_layouts "struct RenderLayoutVertex${layout} {\n    PR_GPU_ATTRIBUTE(float3, position, 0);\n")
    string(APPEND slang_layouts "    PR_GPU_ATTRIBUTE(float4, normal, 1);\n    PR_GPU_ATTRIBUTE(float4, tangent, 2);\n")
    string(APPEND slang_layouts "${vertex_fields}};\n\n")
    string(APPEND slang_layouts "// What a draw of the layout carries from its vertex shader to its fragment shader.\n")
    string(APPEND slang_layouts "struct RenderLayoutVaryings${layout} {\n    RenderVaryings ")
    string(APPEND slang_layouts "surface;\n${varying_fields}};\n\n")
    string(APPEND slang_layouts "// Returns what a vertex of the draw `index` carries, at its position in `view`.\n")
    string(APPEND slang_layouts "RenderLayoutVaryings${layout} renderLayoutVaryings${layout}(")
    string(APPEND slang_layouts "RenderLayoutVertex${layout} attributes, uint index, uint view) {\n")
    string(APPEND slang_layouts "    RenderVertex vertex;\n    vertex.position = attributes.position;\n")
    string(APPEND slang_layouts "    vertex.normal = attributes.normal;\n    vertex.tangent = attributes.tangent;\n")
    string(APPEND slang_layouts "    RenderLayoutVaryings${layout} out;\n    out.surface = renderVaryings(vertex, ")
    string(APPEND slang_layouts "index, view);\n")
    string(APPEND slang_layouts "${copy}    return out;\n}\n\n")
    string(APPEND slang_layouts "// The layout's attributes at a fragment, with the derivatives of its sets of ")
    string(APPEND slang_layouts "texture coordinates.\n")
    string(APPEND slang_layouts "struct RenderLayoutPoint${layout} {\n${point_fields}    uint _unused;\n};\n\n")
    string(APPEND slang_layouts "// Returns the layout's attributes at a fragment. A fragment shader calls it before ")
    string(APPEND slang_layouts "any branch, since it takes\n")
    string(APPEND slang_layouts "// derivatives.\nRenderLayoutPoint${layout} renderLayoutPoint${layout}(RenderLayoutVa")
    string(APPEND slang_layouts "ryings${layout} input) {\n")
    string(APPEND slang_layouts "    RenderLayoutPoint${layout} point;\n    point._unused = 0;\n${point_fill}    ")
    string(APPEND slang_layouts "return point;\n}\n\n")
    string(APPEND slang_layouts "// The layout's attributes at one vertex, as a shader that pulls the vertex reads ")
    string(APPEND slang_layouts "them.\n")
    string(APPEND slang_layouts "struct RenderLayoutValues${layout} {\n${value_fields}    uint _unused;\n};\n\n")
    string(APPEND slang_layouts "#if !defined(PR_RENDER_SLOTS)\n\n")
    string(APPEND slang_layouts "// Returns the layout's attributes of the vertex `index` of a draw.\n")
    string(APPEND slang_layouts "RenderLayoutValues${layout} renderLayoutPull${layout}(PrRenderDrawRecord draw, uint ")
    string(APPEND slang_layouts "index) {\n")
    string(APPEND slang_layouts "    RenderLayoutValues${layout} values;\n    values._unused = 0;\n${pull}    return ")
    string(APPEND slang_layouts "values;\n}\n\n")
    string(APPEND slang_layouts "#endif\n")
endforeach()

# Each variant's attributes from what a fragment interpolates, and from the corners of a triangle at a pixel. An
# attribute that the variant's layout lacks is its value where a vertex lacks it, which the shader holds.
math(EXPR variant_last "${variant_count} - 1")
foreach (variant RANGE ${variant_last})
    set(index ${variant_type_${variant}})
    list(GET TYPES ${index} type)
    list(GET STRUCTURES ${index} structure)
    set(layout ${variant_layout_${variant}})
    set(mask ${variant_mask_${variant}})
    set(from_varyings "")
    set(from_corners "")
    foreach (attribute IN LISTS fields_${index})
        string(REPLACE "|" ";" parts "${attribute}")
        list(GET parts 0 field_name)
        list(GET parts 1 semantic)
        list(GET parts 2 format)
        list(GET parts 3 values)
        list(GET parts 4 bit)
        string(REPLACE "|" ";" description "${format_${format}}")
        list(GET description 2 components)
        list(GET description 5 format_type)
        set(v "${field_name}")
        math(EXPR selected "${mask} & ${bit}")
        if (NOT bit EQUAL 0 AND selected EQUAL 0)
            string(REPLACE "," ";" numbers "${values}")
            list(SUBLIST numbers 0 ${components} numbers)
            list(JOIN numbers ", " numbers)
            if (semantic STREQUAL "uv")
                set(constant "    attributes.${v}.value = float2(${numbers});\n")
                string(APPEND constant "    attributes.${v}.dx = float2(0, 0);\n    attributes.${v}.dy = float2(0, 0);\n")
            else()
                set(constant "    attributes.${v} = ${format_type}(${numbers});\n")
            endif()
            string(APPEND from_varyings "${constant}")
            string(APPEND from_corners "${constant}")
        elseif (semantic STREQUAL "uv")
            string(APPEND from_varyings "    attributes.${v} = input.${v};\n")
            string(APPEND from_corners "    attributes.${v}.value = a.${v} * w.x + b.${v} * w.y + c.${v} * w.z;\n")
            string(APPEND from_corners "    attributes.${v}.dx = a.${v} * dx.x + b.${v} * dx.y + c.${v} * dx.z;\n")
            string(APPEND from_corners "    attributes.${v}.dy = a.${v} * dy.x + b.${v} * dy.y + c.${v} * dy.z;\n")
        elseif (format_type MATCHES "^u?int")
            string(APPEND from_varyings "    attributes.${v} = input.${v};\n")
            string(APPEND from_corners "    attributes.${v} = a.${v};\n")
        else()
            string(APPEND from_varyings "    attributes.${v} = input.${v};\n")
            string(APPEND from_corners "    attributes.${v} = a.${v} * w.x + b.${v} * w.y + c.${v} * w.z;\n")
        endif()
    endforeach()
    set(which "the type ${type}")
    if (mask GREATER 0)
        set(which "the variant ${mask} of the type ${type}")
    endif()
    string(APPEND slang_types "\n// The attributes of a material of ${which}, as a fragment interpolates them.\n")
    string(APPEND slang_types "${structure}.Attributes renderVaryingAttributes${variant}(RenderLayoutPoint${layout} ")
    string(APPEND slang_types "input) {\n")
    string(APPEND slang_types "    ${structure}.Attributes attributes;\n${from_varyings}    return attributes;\n}\n")
    string(APPEND slang_types "\n#if !defined(PR_RENDER_SLOTS)\n\n")
    string(APPEND slang_types "// The attributes of a material of ${which} at a point of a triangle.\n")
    string(APPEND slang_types "${structure}.Attributes renderCornerAttributes${variant}(RenderCorners corners) {\n")
    string(APPEND slang_types "    RenderLayoutValues${layout} a = renderLayoutPull${layout}(corners.draw, ")
    string(APPEND slang_types "corners.index[0]);\n")
    string(APPEND slang_types "    RenderLayoutValues${layout} b = renderLayoutPull${layout}(corners.draw, ")
    string(APPEND slang_types "corners.index[1]);\n")
    string(APPEND slang_types "    RenderLayoutValues${layout} c = renderLayoutPull${layout}(corners.draw, ")
    string(APPEND slang_types "corners.index[2]);\n")
    string(APPEND slang_types "    float3 w = corners.weights;\n    float3 dx = corners.weightsDx;\n    float3 dy = ")
    string(APPEND slang_types "corners.weightsDy;\n")
    string(APPEND slang_types "    ${structure}.Attributes attributes;\n${from_corners}    return ")
    string(APPEND slang_types "attributes;\n}\n\n#endif\n")
endforeach()

# ----------------------------------------------------------------------------------------------------------------------
# The dispatch and the passes' sources

# Sets `out` to a function's body that returns `fallback`, or the value that `cases` return for the variants of
# material types that they name.
function(dispatch out cases fallback)
    if (cases)
        set(${out} "    switch (material.variant) {\n${cases}        default:\n            return ${fallback};\n    }\n"
            PARENT_SCOPE)
    else()
        set(${out} "    return ${fallback};\n" PARENT_SCOPE)
    endif()
endfunction()

set(banner "// Generated by render_shaders_check.cmake for the shader set ${NAME}. Do not edit.\n")
set(forward "${banner}//\n// The forward technique's shaders: a vertex shader for each layout of the set's material ")
string(APPEND forward "types' attributes, and a\n")
string(APPEND forward "// fragment shader for each type.\n\n#include \"render/src/render_forward.slang\"\n")
set(depth_mask "${banner}//\n// The masked depth's shaders: a vertex shader for each layout of the set's material ")
string(APPEND depth_mask "types' attributes, and a\n")
string(APPEND depth_mask "// fragment shader for each layout, which dispatches on its material's type.\n\n")
string(APPEND depth_mask "#include \"render/src/render_depth_mask.slang\"\n")
set(visibility "${banner}//\n// The visibility technique's shaders, which the pass's source holds whole: the set's ")
string(APPEND visibility "dispatch is in")
string(APPEND visibility "\n// render_shader_set.slang.\n\n#include \"render/src/render_visibility.slang\"\n")

# The alpha of a material of each layout, for the passes that test a masked material, by a switch on the variants of
# the layout. The first variant of a layout is the default of its switch.
set(alpha_text "")
foreach (layout RANGE ${layout_last})
    set(cases "")
    set(default "")
    foreach (variant IN LISTS layout_variants_${layout})
        set(index ${variant_type_${variant}})
        list(GET STRUCTURES ${index} structure)
        set(call "renderMaterialSurface<${structure}>(material, inputs, renderVaryingAttributes${variant}(input), ")
        string(APPEND call "renderTextures${index}(material)).alpha")
        if (default STREQUAL "")
            set(default "${call}")
        else()
            string(APPEND cases "        case ${variant}:\n            return ${call};\n")
        endif()
    endforeach()
    dispatch(body "${cases}" "${default}")
    string(APPEND alpha_text "\n// Returns the alpha of a material of layout ${layout}'s types at a point of its ")
    string(APPEND alpha_text "surface.\n")
    string(APPEND alpha_text "float renderLayoutAlpha${layout}(PrRenderMaterialRecord material, RenderSurfaceInputs ")
    string(APPEND alpha_text "inputs, ")
    string(APPEND alpha_text "RenderLayoutPoint${layout} input) {\n${body}}\n")

    set(vertex_parameters "RenderLayoutVertex${layout} attributes")
    set(vertex_body "    return renderLayoutVaryings${layout}(attributes, push.draw, push.view);\n}\n")
    string(APPEND forward "\n[shader(\"vertex\")]\nRenderLayoutVaryings${layout} forwardVertex${layout}(")
    string(APPEND forward "${vertex_parameters}) {\n")
    string(APPEND forward "${vertex_body}")
    string(APPEND depth_mask "\n[shader(\"vertex\")]\nRenderLayoutVaryings${layout} depthMaskVertex${layout}(")
    string(APPEND depth_mask "${vertex_parameters}) {\n")
    string(APPEND depth_mask "${vertex_body}")
    string(APPEND depth_mask "\n[shader(\"fragment\")]\nvoid depthMaskPixel${layout}(RenderLayoutVaryings${layout} ")
    string(APPEND depth_mask "input, ")
    string(APPEND depth_mask "bool isFront : SV_IsFrontFace) {\n")
    string(APPEND depth_mask "    RenderSurfaceInputs inputs = renderVaryingInputs(input.surface, isFront);\n")
    string(APPEND depth_mask "    RenderLayoutPoint${layout} point = renderLayoutPoint${layout}(input);\n")
    string(APPEND depth_mask "    PrRenderMaterialRecord material = renderMaterial(inputs.material);\n")
    string(APPEND depth_mask "    if (renderLayoutAlpha${layout}(material, inputs, point) < material.alphaCutoff)\n   ")
    string(APPEND depth_mask "     discard;\n}\n")
endforeach()

# The forward technique's fragment shader of each variant of each type.
foreach (variant RANGE ${variant_last})
    set(index ${variant_type_${variant}})
    list(GET STRUCTURES ${index} structure)
    set(layout ${variant_layout_${variant}})
    set(fragment ${variant_fragment_${variant}})
    string(APPEND forward "\n[shader(\"fragment\")]\nfloat4 ${fragment}(RenderLayoutVaryings${layout} input, ")
    string(APPEND forward "bool isFront : SV_IsFrontFace) : SV_Target {\n")
    string(APPEND forward "    RenderSurfaceInputs inputs = renderVaryingInputs(input.surface, isFront);\n")
    string(APPEND forward "    RenderLayoutPoint${layout} point = renderLayoutPoint${layout}(input);\n")
    string(APPEND forward "    ${structure}.Attributes attributes = renderVaryingAttributes${variant}(point);\n")
    string(APPEND forward "    return renderForwardPixel<${structure}>(inputs, attributes, renderTextures${index}(")
    string(APPEND forward "renderMaterial(inputs.material)));\n}\n")
endforeach()

# The radiance of any material, for the visibility technique's shading: a dispatch by the shading model and then by the
# type, so that a shader holds each model's shading once. Each type's case pulls the attributes of its own layout. The
# first type is the default of each dispatch.
set(arguments "PrRenderMaterialRecord material, RenderSurfaceInputs inputs, RenderCorners corners")
set(radiance_text "\n#if !defined(PR_RENDER_SLOTS)\n")
set(cases "")
foreach (variant RANGE ${variant_last})
    set(index ${variant_type_${variant}})
    list(GET STRUCTURES ${index} structure)
    set(call "renderMaterialSurface<${structure}>(material, inputs, renderCornerAttributes${variant}(corners), ")
    string(APPEND call "renderTextures${index}(material)).alpha")
    if (variant EQUAL 0)
        set(default "${call}")
    else()
        string(APPEND cases "        case ${variant}:\n            return ${call};\n")
    endif()
endforeach()
dispatch(body "${cases}" "${default}")
string(APPEND radiance_text "\n// Returns the alpha of any material at a point of a triangle, for a pass that tests ")
string(APPEND radiance_text "it away from varyings.\n")
string(APPEND radiance_text "float renderMaterialAlphaAt(${arguments}) {\n${body}}\n")

set(radiance_cases "")
set(model_index 0)
foreach (surface IN LISTS models)
    set(cases "")
    set(default "")
    foreach (variant IN LISTS model_${surface}_variants)
        set(index ${variant_type_${variant}})
        list(GET STRUCTURES ${index} structure)
        set(call "renderMaterialSurface<${structure}>(material, inputs, renderCornerAttributes${variant}(corners), ")
        string(APPEND call "renderTextures${index}(material))")
        if (default STREQUAL "")
            set(default "${call}")
            set(first_structure ${structure})
        else()
            string(APPEND cases "        case ${variant}:\n            return ${call};\n")
        endif()
        if (model_index GREATER 0)
            string(APPEND radiance_cases "        case ${variant}:\n")
        endif()
    endforeach()
    dispatch(body "${cases}" "${default}")
    string(APPEND radiance_text "\n// Returns the surface of a material that the shading model ${surface} lights.\n")
    string(APPEND radiance_text "${first_structure}.Surface renderModelSurface${model_index}(${arguments}) {\n${body}}")
    string(APPEND radiance_text "\n")
    if (model_index GREATER 0)
        string(APPEND radiance_cases "            return renderShadeAlpha(renderModelSurface${model_index}(material, ")
        string(APPEND radiance_cases "inputs, corners), inputs, emission);\n")
    endif()
    math(EXPR model_index "${model_index} + 1")
endforeach()
dispatch(body "${radiance_cases}" "renderShadeAlpha(renderModelSurface0(material, inputs, corners), inputs, emission)")
string(APPEND radiance_text "\n// Returns the radiance that leaves a point of a material's surface toward the camera, ")
string(APPEND radiance_text "and in alpha the surface's\n")
string(APPEND radiance_text "// alpha.\nfloat4 renderMaterialRadiance(${arguments}) {\n    float emission = ")
string(APPEND radiance_text "renderMaterialEmission(material);\n")
string(APPEND radiance_text "${body}}\n\n#endif\n")

set(set_text "${banner}//\n// The set's material types, as the passes call them: the code that fills each type's ")
string(APPEND set_text "textures and attributes, the\n")
string(APPEND set_text "// varyings of each layout of their attributes, and the dispatch on a material's ")
string(APPEND set_text "type.\n\n#pragma once\n\n")
string(APPEND set_text "#include \"render_shader_sources.slang\"\n#include \"render/src/render_varyings.slang\"\n")
string(APPEND set_text "${slang_layouts}\n// -------------------------------------------------------------------------")
string(APPEND set_text "--------------------------------------------\n")
string(APPEND set_text "// Types\n${slang_types}${alpha_text}${radiance_text}")
file(CONFIGURE OUTPUT "${SET_DIRECTORY}/render_shader_set.slang" CONTENT "${set_text}" @ONLY)
file(CONFIGURE OUTPUT "${SET_DIRECTORY}/render_shader_forward.slang" CONTENT "${forward}" @ONLY)
file(CONFIGURE OUTPUT "${SET_DIRECTORY}/render_shader_depth_mask.slang" CONTENT "${depth_mask}" @ONLY)
file(CONFIGURE OUTPUT "${SET_DIRECTORY}/render_shader_visibility.slang" CONTENT "${visibility}" @ONLY)

# ----------------------------------------------------------------------------------------------------------------------
# The set's data and its header

set(layouts_text "")
foreach (layout RANGE ${layout_last})
    string(APPEND layouts_text "${c_layout_${layout}}")
endforeach()
file(CONFIGURE OUTPUT "${HEADER}" @ONLY CONTENT
"// Generated by render_shaders_check.cmake for the shader set @NAME@. Do not edit.
//
// The set's material types and the layouts of their attributes, as the compiler reflects them.

#pragma once

#include \"pr/render_shaders.h\"

namespace {

// The layouts of the variants' attributes, which variants of equal attributes share.
@c_layouts@const PrRenderVertexLayout kLayouts[] = {
@layouts_text@};

// The variants of the types, each type's in the order of the sets of its optional attributes.
const PrRenderMaterialVariant kVariants[] = {
@c_variants@};

// By type, its parameters, its textures and the names of its optional attributes.
@c_parameters@@c_textures@@c_optionals@// The material types, by id.
const PrRenderMaterialType kMaterialTypes[] = {
@c_types@};

} // namespace
")

string(SUBSTRING ${NAME} 0 1 first)
string(SUBSTRING ${NAME} 1 -1 rest)
string(TOLOWER ${first} first)
set(type_ids "")
set(id 0)
foreach (type IN LISTS TYPES)
    string(APPEND type_ids "    k${NAME}Material${type} = ${id},\n")
    math(EXPR id "${id} + 1")
endforeach()
file(CONFIGURE OUTPUT "${SET_DIRECTORY}/include/render_shaders/${NAME}Shaders.h" @ONLY CONTENT
"// Generated by render_shaders_check.cmake for the shader set @NAME@. Do not edit.

#pragma once

#include \"pr/render_shaders.h\"

#if defined(__cplusplus)
extern \"C\" {
#endif

// The set's material types, as a material's description names its type (PrRenderMaterialDesc::type).
enum {
@type_ids@    k@NAME@MaterialCount = @count@,
};

// By type, the index of each of its parameters (PrRenderMaterialType::parameters), of each of its textures
// (PrRenderMaterialDesc::textures) and of each of its attributes, as the type declares them.
enum {
@constants@};

// The set's tables, as the source of a table names it (PrRenderTableSource::table).
enum {
@TABLE_IDS@};

// Returns the shader set, which a renderer is created with (PrRenderOptions::shaders).
const PrRenderShaderSet* PR_NONNULL @FUNCTION@(void);

#if defined(__cplusplus)
}
#endif
")
write_depfile("${DEPFILE}" "${HEADER}")
